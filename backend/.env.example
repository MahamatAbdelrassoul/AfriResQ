# USSD and inbound SMS. The network or Africa's Talking posts to this API.
# Put the key on the callback URL: https://your-host/api/channels/ussd?key=...
# and https://your-host/api/channels/sms?key=...
# The short code itself is assigned by the operator. This is the code people dial.
CHANNEL_WEBHOOK_KEY=
USSD_CODE="*284#"
STUDENT_EMAIL_DOMAIN=students.mak.ac.ug
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Maps. Finds a partner on the map from its address when it gave no map point. Turn on the Geocoding API for this key.
GOOGLE_MAPS_API_KEY=
